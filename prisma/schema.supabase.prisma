// Target schema after running migrate-users-to-supabase.ts.
//
// Auth is now handled entirely by Supabase Auth, whose users live in the
// `auth` schema (not modelled here — Prisma doesn't need to know about it).
// `routes.user_id` stores the Supabase Auth user's UUID directly, with no
// Prisma-level relation into it.
//
// Once migrate-users-to-supabase.ts has been run against the database,
// replace prisma/schema.prisma with this file and run `npx prisma generate`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model routes {
  id              Int      @unique(map: "idx_24579_id") @default(autoincrement())
  identifier      String   @unique(map: "idx_24579_identifier") @db.VarChar(255)
  gpx_storage_key String?  @db.VarChar(500)
  gpx_size_bytes  BigInt?
  gpx_sha256      String?  @db.Char(64)
  time            DateTime @default(now()) @db.Timestamptz(6)
  last_viewed_at  DateTime @default(now()) @db.Timestamptz(6)
  view_count      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  title           String?  @db.VarChar(255)
  description     String?

  user_id String? @db.Uuid

  @@index([user_id])
}
