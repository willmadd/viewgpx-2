generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model routes {
  id              Int      @unique(map: "idx_24579_id") @default(autoincrement())
  identifier      String   @unique(map: "idx_24579_identifier") @db.VarChar(255)
  gpx_storage_key String?  @db.VarChar(500)
  gpx_size_bytes  BigInt?
  gpx_sha256      String?  @db.Char(64)
  thumbnail_key   String?  @db.VarChar(500)
  time            DateTime @default(now()) @db.Timestamptz(6)
  last_viewed_at  DateTime @default(now()) @db.Timestamptz(6)
  view_count      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  title           String?  @db.VarChar(255)
  description     String?
  type            String?  @db.VarChar(40)

  user_id String? @db.Uuid

  page_routes page_routes[]

  @@index([user_id])
}

model admins {
  user_id    String   @id @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model pages {
  id          Int      @id @default(autoincrement())
  identifier  String   @unique @db.VarChar(255)
  user_id     String   @db.Uuid
  title       String?  @db.VarChar(255)
  description String?
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  page_routes page_routes[]

  @@index([user_id])
}

model page_routes {
  page_id    Int
  route_id   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  page  pages  @relation(fields: [page_id], references: [id], onDelete: Cascade)
  route routes @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@id([page_id, route_id])
  @@index([route_id])
}
